{
  "expo": {
    "name": "Meka",
    "slug": "gymapp-social-mobile-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "bundleIdentifier": "com.sterling.meka",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sterling.meka",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/spalsh-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "610844d3-d3f7-46f9-8bd7-4b016d388b32"
      }
    }
  }
}
