{
  "expo": {
    "name": "Meka",
    "slug": "gymapp-social-mobile-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "bundleIdentifier": "com.sterling.meka",
      "supportsTablet": true,
      "buildNumber": "1.0.2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to help you choose your home gym nearby.",
        "NSPhotoLibraryUsageDescription": "We use your photo library so you can upload profile photos.",
        "NSPhotoLibraryAddUsageDescription": "We may save edited or cropped photos back to your library.",
        "NSCameraUsageDescription": "We use the camera so you can take a new profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sterling.meka",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#121212"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/splash-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "610844d3-d3f7-46f9-8bd7-4b016d388b32"
      }
    }
  }
}
